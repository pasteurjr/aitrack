{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vehicle-monitoring-decision.v1",
  "title": "Decisão estruturada de monitoramento veicular",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "classification", "confidence", "summary", "risk",
    "evidence", "proposed_actions", "human_review"
  ],
  "properties": {
    "schema_version": {"const": "vehicle-monitoring-decision.v1"},
    "classification": {
      "enum": ["normal", "attention", "suspected_incident", "confirmed_incident", "insufficient_evidence"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 10, "maxLength": 1000},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "rationale"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "rationale": {"type": "string", "minLength": 5, "maxLength": 1000}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "type", "ref", "summary"],
        "properties": {
          "source": {"enum": ["tracker", "dirijabem", "fused", "system", "operator"]},
          "type": {"type": "string", "minLength": 1, "maxLength": 50},
          "ref": {"type": "string", "minLength": 1, "maxLength": 150},
          "summary": {"type": "string", "minLength": 5, "maxLength": 500},
          "observed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "proposed_actions": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "priority", "rationale", "requires_approval"],
        "properties": {
          "type": {"enum": ["monitor", "contact_owner", "send_message", "call_owner", "notify_operator", "notify_authorities", "request_vehicle_command"]},
          "priority": {"enum": ["low", "normal", "high", "urgent"]},
          "rationale": {"type": "string", "minLength": 5, "maxLength": 500},
          "requires_approval": {"type": "boolean"}
        }
      }
    },
    "human_review": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 5, "maxLength": 500},
        "deadline_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400}
      }
    }
  }
}
